# ============================================================================
# MONEYLIX - Environment Variables Template (.env.local)
# ============================================================================
# Copy this file to .env.local and fill in the actual values
# Do NOT commit .env.local to version control
# 
# CRITICAL vs OPTIONAL:
# - CRITICAL: Must be configured for the app to work
# - OPTIONAL: Certain features work without these, but functionality is limited
# ============================================================================


# ============================================================================
# 1. APP CONFIGURATION
# ============================================================================
# Critical for: Next.js public environment and URL generation

# Application base URL - used for redirects, callbacks, and public links
# CRITICAL: Update this to your actual domain in production
NEXT_PUBLIC_APP_URL=https://moneylix.in


# ============================================================================
# 2. DATABASE CONFIGURATION
# ============================================================================
# Critical for: Data persistence and user account management

# PostgreSQL connection string
# Format: postgresql://user:password@localhost:5432/moneylix
# CRITICAL: Set up PostgreSQL and update with your connection details
# Current: Configure when database migration is ready
DATABASE_URL=postgresql://user:password@localhost:5432/moneylix


# ============================================================================
# 3. PAYMENT GATEWAY - RAZORPAY
# ============================================================================
# Critical for: Processing payments, subscriptions, and financial transactions
# Service: Razorpay (https://razorpay.com)
# Setup Guide: 
#   1. Create account at https://razorpay.com
#   2. Go to Settings → API Keys (Live/Test)
#   3. Copy Key ID and Key Secret
#   4. Set up webhook at https://dashboard.razorpay.com/app/settings/webhooks

# Your Razorpay Key ID (public, but keep secret)
# Obtain from: https://dashboard.razorpay.com/app/settings/api-keys
# CRITICAL
RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Your Razorpay Key Secret (NEVER share or commit)
# Obtain from: https://dashboard.razorpay.com/app/settings/api-keys
# CRITICAL - Keep this secret!
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret - used to verify webhook signatures
# Obtain from: https://dashboard.razorpay.com/app/settings/webhooks
# Create webhook endpoint: POST /api/webhooks/razorpay
# Events to subscribe: payment.authorized, payment.failed, subscription.created, etc.
# CRITICAL - Verify webhook signature to prevent fraud
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here


# ============================================================================
# 4. EMAIL SERVICE - RESEND
# ============================================================================
# Critical for: Sending transactional emails, password resets, notifications
# Service: Resend (https://resend.com)
# Setup Guide:
#   1. Create account at https://resend.com
#   2. Go to API Keys in dashboard
#   3. Create new API key with "Sending" permission
#   4. Verify domain (if using custom domain emails)

# Resend API Key (NEVER share or commit)
# Obtain from: https://resend.com/api-keys
# CRITICAL for email functionality
RESEND_API_KEY=your_resend_api_key_here

# Optional: Resend email domain (if using custom domain)
# Default sends from "noreply@resend.dev"
# OPTIONAL: Set only if you have verified custom domain in Resend
RESEND_FROM_EMAIL=noreply@moneylix.in


# ============================================================================
# 5. ACCOUNT AGGREGATION - SETU AA (Account Aggregator)
# ============================================================================
# Critical for: Open Banking integration, fetching bank statements, transactions
# Service: Setu Account Aggregator (https://setu.co)
# Setup Guide:
#   1. Register at https://setu.co
#   2. Go to Settings → API Keys
#   3. Copy Client ID and Client Secret
#   4. Note your FIU ID (Financial Information User ID)
#   5. Configure AA base URL (test/production)

# Setu AA Client ID (public in some contexts, keep secure)
# Obtain from: https://dashboard.setu.co/settings/api-keys
# CRITICAL for bank account aggregation
SETU_AA_CLIENT_ID=your_setu_client_id_here

# Setu AA Client Secret (NEVER share or commit)
# Obtain from: https://dashboard.setu.co/settings/api-keys
# CRITICAL - Keep this secret!
SETU_AA_CLIENT_SECRET=your_setu_client_secret_here

# Setu Account Aggregator Base URL
# Test: https://sandbox.setu.co
# Production: https://api.setu.co
# CRITICAL: Use correct URL for environment
SETU_AA_BASE_URL=https://sandbox.setu.co

# Your FIU ID (Financial Information User ID)
# Obtain from: https://dashboard.setu.co/settings
# CRITICAL for RBI Account Aggregator integration
SETU_AA_FIU_ID=your_fiu_id_here

# Optional: Setu webhook secret for account aggregation callbacks
# OPTIONAL: Set if using webhooks for AA events
SETU_AA_WEBHOOK_SECRET=your_setu_webhook_secret_here


# ============================================================================
# 6. TOKEN ENCRYPTION
# ============================================================================
# Critical for: Encrypting sensitive tokens and secrets stored in database
# These tokens are used to encrypt/decrypt sensitive data like bank tokens
# 
# IMPORTANT: Do NOT use the same key in different environments!
# IMPORTANT: Rotate this key carefully - existing encrypted data becomes unreadable

# 32-byte Base64-encoded encryption key for token encryption
# Generate new key using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Or: openssl rand -base64 32
# CRITICAL: Store securely, never commit to version control
TOKEN_ENCRYPTION_KEY=your_32_byte_base64_encoded_key_here

# Alternative: If using separate initialization vector (IV)
# Most implementations derive IV from key, so this is OPTIONAL
TOKEN_ENCRYPTION_IV=


# ============================================================================
# 7. AI/ML - GEMINI API
# ============================================================================
# Optional for: Financial insights, spending analysis, AI recommendations
# Service: Google Gemini API (https://ai.google.dev)
# Setup Guide:
#   1. Go to https://ai.google.dev
#   2. Create account and enable Gemini API
#   3. Generate API key
#   4. Set up usage limits

# Gemini API Key (NEVER share or commit)
# Obtain from: https://ai.google.dev/tutorials/setup
# OPTIONAL: Financial insights work without this, but with reduced functionality
GEMINI_API_KEY=your_gemini_api_key_here


# ============================================================================
# 7b. INTERNAL CRON SCHEDULER
# ============================================================================
# Secret used to authenticate internal cron job calls.
# The scheduler (src/lib/scheduler.ts) passes this as ?secret= to cron endpoints.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# OPTIONAL: If not set, cron endpoints accept unauthenticated calls (fine for local dev)
CRON_SECRET=your_cron_secret_here


# ============================================================================
# 8. BANK CONNECTIVITY - PLAID (International)
# ============================================================================
# Optional for: International bank connectivity, alternative to Setu AA
# Service: Plaid (https://plaid.com)
# Setup Guide:
#   1. Create account at https://plaid.com
#   2. Go to Keys & Credentials
#   3. Copy Client ID and Secret
#   4. Choose appropriate environment (sandbox/production)

# Plaid Client ID
# Obtain from: https://dashboard.plaid.com/team/keys
# OPTIONAL: For international bank connections
PLAID_CLIENT_ID=your_plaid_client_id_here

# Plaid Secret Key (NEVER share or commit)
# Obtain from: https://dashboard.plaid.com/team/keys
# OPTIONAL - Keep this secret!
PLAID_CLIENT_SECRET=your_plaid_client_secret_here

# Plaid Environment
# Options: sandbox, development, production
# Recommendation: Use "sandbox" for testing
# OPTIONAL: Only needed if using Plaid integration
PLAID_ENV=sandbox


# ============================================================================
# 9. LOGGING & DEBUGGING (Development)
# ============================================================================
# Optional for: Development debugging and monitoring

# Next.js debug mode
# OPTIONAL: Set to true for detailed logging during development
DEBUG=moneylix:*

# Log level (development vs production)
# OPTIONAL: Options - error, warn, info, debug, trace
LOG_LEVEL=info


# ============================================================================
# 10. FEATURE FLAGS (Optional)
# ============================================================================
# These can be used to enable/disable features without code changes

# Enable/disable Setu AA integration
# OPTIONAL: Set to false to disable account aggregation feature
FEATURE_SETU_AA_ENABLED=true

# Enable/disable Plaid integration
# OPTIONAL: Set to false to disable international bank connectivity
FEATURE_PLAID_ENABLED=false

# Enable/disable Gemini AI features
# OPTIONAL: Set to false to disable AI insights
FEATURE_GEMINI_ENABLED=true


# ============================================================================
# QUICK SETUP CHECKLIST
# ============================================================================
# 1. [ ] Create .env.local file by copying this template
# 2. [ ] Set NEXT_PUBLIC_APP_URL to your domain
# 3. [ ] Configure DATABASE_URL for PostgreSQL
# 4. [ ] Create Razorpay account and add credentials (CRITICAL)
# 5. [ ] Create Resend account and add API key (CRITICAL)
# 6. [ ] Create Setu AA account and add credentials (CRITICAL)
# 7. [ ] Generate TOKEN_ENCRYPTION_KEY using command below (CRITICAL)
# 8. [ ] Create Gemini API key (OPTIONAL but recommended)
# 9. [ ] Set up Plaid if targeting international markets (OPTIONAL)
# 10. [ ] Never commit .env.local to git - add to .gitignore
#
# GENERATE TOKEN_ENCRYPTION_KEY:
# macOS/Linux:  openssl rand -base64 32
# Windows:      node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ============================================================================


# ============================================================================
# SECURITY REMINDERS
# ============================================================================
# ⚠️  DO NOT:
#   - Commit .env.local to version control
#   - Share these credentials via email or chat
#   - Use same keys across different environments
#   - Log or print these values in production
#
# ✅  DO:
#   - Add .env.local to .gitignore
#   - Rotate keys regularly (especially if exposed)
#   - Use separate keys for dev/staging/production
#   - Enable IP whitelisting where possible
#   - Monitor API usage and set up alerts
#   - Use environment-specific secrets management (AWS Secrets Manager, HashiCorp Vault)
# ============================================================================