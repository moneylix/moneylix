  "help": {
    "title": "Help Center",
    "subtitle": "Find answers or contact our support team",
    "quickStart": "Quick Start",
    "billing": "Billing",
    "security": "Security",
    "contactUs": "Contact Us",
    "gettingStarted": "Getting Started",
    "paymentsAndPlans": "Payments & Plans",
    "dataAndSecurity": "Data & Security",
    "features": "Features",
    "gs1q": "How do I add a transaction?",
    "gs1a": "Click the + button in the top right, or press the \"A\" key anywhere in the dashboard. Fill in type (credit/debit), amount, category, and date.",
    "gs2q": "What is a Business?",
    "gs2a": "A Business is a separate ledger for tracking finances. Free plan allows 1, Pro allows 3, Premium allows unlimited. Switch between businesses using the switcher in the sidebar.",
    "gs3q": "How do I switch between businesses?",
    "gs3a": "Use the business switcher at the top of the sidebar. Click it to see all your businesses or create a new one.",
    "pp1q": "How do I upgrade my plan?",
    "pp1a": "Go to Plans & Pricing in the sidebar. Click Upgrade to Pro or Premium, complete the Razorpay checkout. Your plan activates instantly after payment.",
    "pp2q": "When does my plan expire?",
    "pp2a": "Plans are billed monthly from the date of purchase. You will see an expiry warning banner on the dashboard when your plan is within 7 days of expiry.",
    "pp3q": "Can I get a refund?",
    "pp3a": "Contact support within 7 days of purchase for a full refund. Refunds are processed within 5-7 business days to your original payment method.",
    "pp4q": "What payment methods are accepted?",
    "pp4a": "We accept all major credit/debit cards, UPI, net banking, and wallets through Razorpay.",
    "ds1q": "How do I export my data?",
    "ds1a": "Go to Settings → Export Data. Choose CSV or JSON format. Pro and Premium plans support CSV export; Premium supports both CSV and JSON.",
    "ds2q": "How do I import transactions?",
