  "help": {
    "title": "உதவி மையம்",
    "subtitle": "பதில்களைக் கண்டறியவும் அல்லது எங்கள் ஆதரவு குழுவைத் தொடர்பு கொள்ளவும்",
    "quickStart": "விரைவு தொடக்கம்",
    "billing": "பில்லிங்",
    "security": "பாதுகாப்பு",
    "contactUs": "எங்களைத் தொடர்பு கொள்ளவும்",
    "gettingStarted": "தொடங்குதல்",
    "paymentsAndPlans": "கொடுப்பனவுகள் & திட்டங்கள்",
    "dataAndSecurity": "தரவு & பாதுகாப்பு",
    "features": "அம்சங்கள்",
    "gs1q": "பரிவர்த்தனையை எப்படி சேர்ப்பது?",
    "gs1a": "மேல் வலதுபுறத்தில் உள்ள + பொத்தானை கிளிக் செய்யவும், அல்லது டாஷ்போர்டில் எங்கும் \"A\" விசையை அழுத்தவும். வகை (கடன்/பற்று), தொகை, வகைப்பாடு மற்றும் தேதியை நிரப்பவும்.",
    "gs2q": "வணிகம் என்றால் என்ன?",
    "gs2a": "வணிகம் என்பது நிதியைக் கண்காணிக்க தனி கணக்குப் புத்தகம். இலவச திட்டம் 1ஐ அனுமதிக்கிறது, Pro 3ஐ அனுமதிக்கிறது, Premium வரம்பற்றதை அனுமதிக்கிறது. பக்கப்பட்டியில் உள்ள மாற்றியைப் பயன்படுத்தி வணிகங்களுக்கு இடையே மாறவும்.",
    "gs3q": "வணிகங்களுக்கு இடையே எப்படி மாறுவது?",
    "gs3a": "பக்கப்பட்டியின் மேலே உள்ள வணிக மாற்றியைப் பயன்படுத்தவும். உங்கள் அனைத்து வணிகங்களையும் பார்க்க அல்லது புதிதாக உருவாக்க அதைக் கிளிக் செய்யவும்.",
    "pp1q": "எனது திட்டத்தை எப்படி மேம்படுத்துவது?",
    "pp1a": "பக்கப்பட்டியில் உள்ள திட்டங்கள் & விலைநிர்ணயத்திற்குச் செல்லவும். Pro அல்லது Premium க்கு மேம்படுத்து என்பதைக் கிளிக் செய்து, Razorpay செக்அவுட்டை முடிக்கவும். பணம் செலுத்திய பிறகு உங்கள் திட்டம் உடனடியாக செயல்படுத்தப்படும்.",
    "pp2q": "எனது திட்டம் எப்போது காலாவதியாகும்?",
    "pp2a": "திட்டங்கள் வாங்கிய தேதியிலிருந்து மாதந்தோறும் கட்டணம் வசூலிக்கப்படும். உங்கள் திட்டம் காலாவதியாக 7 நாட்களுக்குள் இருக்கும்போது டாஷ்போர்டில் ஒரு எச்சரிக்கை பேனரைக் காண்பீர்கள்.",
    "pp3q": "எனக்கு பணத்தைத் திரும்பப் பெற முடியுமா?",
    "pp3a": "முழு பணத்தைத் திரும்பப் பெற வாங்கிய 7 நாட்களுக்குள் ஆதரவைத் தொடர்பு கொள்ளவும். பணத்தைத் திரும்பப் பெறுதல் 5-7 வணிக நாட்களுக்குள் உங்கள் அசல் கட்டண முறைக்கு செயலாக்கப்படும்.",
    "pp4q": "என்ன கட்டண முறைகள் ஏற்றுக்கொள்ளப்படுகின்றன?",
    "pp4a": "Razorpay மூலம் அனைத்து முக்கிய கிரெடிட்/டெபிட் கார்டுகள், UPI, நெட் பேங்கிங் மற்றும் வாலட்களை நாங்கள் ஏற்கிறோம்.",
    "ds1q": "எனது தரவை எப்படி ஏற்றுமதி செய்வது?",
    "ds1a": "அமைப்புகள் → தரவு ஏற்றுமதிக்குச் செல்லவும். CSV அல்லது JSON வடிவமைப்பைத் தேர்ந்தெடுக்கவும். Pro மற்றும் Premium திட்டங்கள் CSV ஏற்றுமதியை ஆதரிக்கின்றன; Premium CSV மற்றும் JSON இரண்டையும் ஆதரிக்கிறது.",
    "ds2q": "பரிவர்த்தனைகளை எப்படி இறக்குமதி செய்வது?",
    "ds2a": "அமைப்புகள் → CSV இறக்குமதிக்குச் செல்லவும். தேதி, வகை, தொகை, வகைப்பாடு, குறிப்பு, முறை, குறிச்சொற்கள் ஆகிய நெடுவரிசைகளுடன் ஒரு CSV கோப்பைப் பதிவேற்றவும்.",
    "ds3q": "எனது தரவு பாதுகாப்பானதா?",
    "ds3a": "ஆம். அனைத்து தரவும் குறியாக்கம் செய்யப்பட்ட இணைப்புகளுடன் (HTTPS) எங்கள் தனியார் சேவையகத்தில் சேமிக்கப்படுகிறது. உங்கள் நிதி தரவை நாங்கள் ஒருபோதும் மூன்றாம் தரப்பினருடன் பகிர மாட்டோம்.",
    "ds4q": "எனது கணக்கை நீக்க முடியுமா?",
    "ds4a": "கணக்கு நீக்கத்தைக் கோர கீழே உள்ள மின்னஞ்சலில் ஆதரவைத் தொடர்பு கொள்ளவும். உங்கள் அனைத்து தரவும் 30 நாட்களுக்குள் நிரந்தரமாக அகற்றப்படும்.",
    "ft1q": "AI ஆலோசகர் என்றால் என்ன?",
    "ft1a": "AI ஆலோசகர் (Premium மட்டும்) உங்கள் செலவு முறைகளை பகுப்பாய்வு செய்து Claude AI ஐப் பயன்படுத்தி தனிப்பயனாக்கப்பட்ட நிதி பரிந்துரைகளை வழங்குகிறது.",
    "ft2q": "OCR ஸ்கேனர் என்றால் என்ன?",
    "ft2a": "உங்கள் கேமராவால் காகித ரசீதுகள் அல்லது பில்களை ஸ்கேன் செய்யவும் (Premium மட்டும்). AI தொகை, தேதி மற்றும் வகைப்பாட்டை தானாகப் படிக்கிறது.",
    "ft3q": "பெறத்தக்கவை என்றால் என்ன?",
    "ft3a": "பெறத்தக்கவை மற்றவர்கள் உங்களுக்கு கடன்பட்ட பணத்தைக் கண்காணிக்கும் (Pro/Premium). பரிவர்த்தனைகளை நிலுவையில் என குறித்து, நிலுவைத் தேதிகள் நெருங்கும்போது நினைவூட்டல்களைப் பெறுங்கள்.",
    "ft4q": "விசைப்பலகை குறுக்குவழிகள் எப்படி வேலை செய்கின்றன?",
    "ft4a": "பரிவர்த்தனையைச் சேர் பாப்-அப்பைத் திறக்க \"A\" ஐ அழுத்தவும். தேடல் பட்டியில் கவனம் செலுத்த \"/\" ஐ அழுத்தவும். எந்த பாப்-அப்பையும் மூட \"Esc\" ஐ அழுத்தவும்.",
